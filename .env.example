# Kopeeri see fail nimega .env ja lisa oma Gemini API võti.
# Ära jaga võtit ega lisa .env faili GitHubi.
GEMINI_API_KEY=lisa-oma-gemini-voti-siia

# Tasuta kasutuskihiga kiire mudel.
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=8080

# Rakenduse püsivad andmed kirjutatakse serveris faili data/app-data.json.
# Railway lisab RAILWAY_VOLUME_MOUNT_PATH muutuja volume'i ühendamisel automaatselt.
